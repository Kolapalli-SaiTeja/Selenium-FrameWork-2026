<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="Suite" parallel="tests" thread-count="3">

	<listeners>

		<listener class-name="com.listeners.MyTestNGListeners"> </listener>
		<!--need to mention where listener class is present-->

		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener"></listener>

		<listener class-name="com.listeners.RetryTransformer"></listener>

	</listeners>


	<test name="Chrome LoginTest">

		<parameter name="browser" value="chrome" />
		<classes>
			<class name="com.testcases.LoginTest" />
			<class name="com.testcases.DashboardTest" />
		     <class name="com.testcases.CartTest" />
		</classes>
	</test>

	<test name="Firefox LoginTest">

		<parameter name="browser" value="firefox" />
		<classes>
			<class name="com.testcases.LoginTest" />
			<class name="com.testcases.DashboardTest" />
			<class name="com.testcases.CartTest" />
		</classes>
	</test>

	<test name="Edge LoginTest">

		<parameter name="browser" value="edge" />
		<classes>
			<class name="com.testcases.LoginTest" />
			<class name="com.testcases.DashboardTest" />
			<class name="com.testcases.CartTest" />
		</classes>
	</test>


</suite> 

